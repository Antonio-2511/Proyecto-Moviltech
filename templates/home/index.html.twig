{% extends 'base.html.twig' %}

{% block title %}Catálogo{% endblock %}

{% block body %}
<div class="container mt-4">

    <h1 class="mb-4">Catálogo de productos</h1>

    {# ── Filtros y búsqueda ── #}
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label class="form-label fw-bold">Buscar</label>
                    <input type="text" id="filtro-busqueda" class="form-control"
                           placeholder="Nombre del producto...">
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Categoría</label>
                    <select id="filtro-categoria" class="form-select">
                        <option value="">Todas las categorías</option>
                        {% for categoria in categorias %}
                            <option value="{{ categoria.id }}">{{ categoria.nombre }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Precio máximo</label>
                    <input type="number" id="filtro-precio" class="form-control"
                           placeholder="Ej: 500" min="0">
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Marca</label>
                    <input type="text" id="filtro-marca" class="form-control"
                           placeholder="Ej: Samsung">
                </div>

                <div class="col-md-3">
                    <button id="btn-limpiar" class="btn btn-outline-secondary w-100">
                        Limpiar filtros
                    </button>
                </div>

            </div>
        </div>
    </div>

    {# Contador de resultados #}
    <p class="text-muted mb-3">
        Mostrando <span id="contador">{{ productos|length }}</span> productos
    </p>

    {# ── Grid de productos ── #}
    <div id="productos-grid" class="row">
        {% for producto in productos %}
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">

                    {% if producto.imagen %}
                        <img src="{{ producto.imagen }}"
                             class="card-img-top"
                             alt="{{ producto.nombre }}">
                    {% endif %}

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">{{ producto.nombre }}</h5>
                        <p class="card-text">{{ producto.descripcion|slice(0, 80) }}...</p>
                        <p class="fw-bold">{{ producto.precio }} €</p>

                        <div class="mt-auto d-flex gap-2">
                            <a href="{{ path('catalogo_producto', {'id': producto.id}) }}"
                               class="btn btn-primary btn-sm">Ver detalle</a>

                            {% if producto.stock > 0 %}
                                <a href="{{ path('carrito_add', {'id': producto.id}) }}"
                                   class="btn btn-success btn-sm">Añadir al carrito</a>
                            {% else %}
                                <button class="btn btn-secondary btn-sm" disabled>Sin stock</button>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <p>No hay productos disponibles.</p>
        {% endfor %}
    </div>

</div>
{% endblock %}

{% block javascripts %}
<script>
    const filtroBusqueda  = document.getElementById('filtro-busqueda');
    const filtroCategoria = document.getElementById('filtro-categoria');
    const filtroPrecio    = document.getElementById('filtro-precio');
    const filtroMarca     = document.getElementById('filtro-marca');
    const grid            = document.getElementById('productos-grid');
    const contador        = document.getElementById('contador');
    const btnLimpiar      = document.getElementById('btn-limpiar');

    const urlFiltrar = "{{ path('catalogo_filtrar') }}";

    function renderProducto(p) {
        const imagen = p.imagen
            ? `<img src="${p.imagen}" class="card-img-top" alt="${p.nombre}">`
            : '';
        const botonCarrito = p.stock > 0
            ? `<a href="/carrito/add/${p.id}" class="btn btn-success btn-sm">Añadir al carrito</a>`
            : `<button class="btn btn-secondary btn-sm" disabled>Sin stock</button>`;

        return `
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                ${imagen}
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">${p.nombre}</h5>
                    <p class="card-text">${p.descripcion}</p>
                    <p class="fw-bold">${p.precio} €</p>
                    <div class="mt-auto d-flex gap-2">
                        <a href="/catalogo/producto/${p.id}" class="btn btn-primary btn-sm">Ver detalle</a>
                        ${botonCarrito}
                    </div>
                </div>
            </div>
        </div>`;
    }

    function aplicarFiltros() {
        const params = new URLSearchParams();

        if (filtroBusqueda.value)  params.set('busqueda',  filtroBusqueda.value);
        if (filtroCategoria.value) params.set('categoria', filtroCategoria.value);
        if (filtroPrecio.value)    params.set('precioMax', filtroPrecio.value);
        if (filtroMarca.value)     params.set('marca',     filtroMarca.value);

        fetch(`${urlFiltrar}?${params.toString()}`)
            .then(res => res.json())
            .then(productos => {
                contador.textContent = productos.length;
                if (productos.length === 0) {
                    grid.innerHTML = '<p class="text-muted">No se encontraron productos con esos filtros.</p>';
                    return;
                }
                grid.innerHTML = productos.map(renderProducto).join('');
            });
    }

    let timeout;
    function filtroConRetraso() {
        clearTimeout(timeout);
        timeout = setTimeout(aplicarFiltros, 300);
    }

    filtroBusqueda.addEventListener('input',  filtroConRetraso);
    filtroCategoria.addEventListener('change', aplicarFiltros);
    filtroPrecio.addEventListener('input',    filtroConRetraso);
    filtroMarca.addEventListener('input',     filtroConRetraso);

    btnLimpiar.addEventListener('click', () => {
        filtroBusqueda.value  = '';
        filtroCategoria.value = '';
        filtroPrecio.value    = '';
        filtroMarca.value     = '';
        aplicarFiltros();
    });
</script>
{% endblock %}
